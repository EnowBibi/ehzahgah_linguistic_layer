# Copy to .env and fill in. Never commit .env.
PORT=3000
# Your sandbox team key (sbx_...). Used only when the gateway does not pass one.
TEAM_KEY=
# Fallback bank base URL. The gateway normally sends bank_api.base_url in every request.
BANK_API_BASE=https://safinum.cm/api/v1
# Fraction of the channel timeout kept in reserve for network and JSON overhead (milliseconds).
SAFETY_MARGIN_MS=400
# Language used when the gateway sends none and nothing is stored.
DEFAULT_LANGUAGE=fr
